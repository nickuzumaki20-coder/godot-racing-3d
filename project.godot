; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to keys

config_version=4

_global_script_classes=[ {
"base": "Reference",
"class": "GameManager",
"language": "GDScript",
"path": "res://Scripts/Managers/GameManager.gd"
}, {
"base": "Reference",
"class": "SaveManager",
"language": "GDScript",
"path": "res://Scripts/Managers/SaveManager.gd"
}, {
"base": "Reference",
"class": "MissionManager",
"language": "GDScript",
"path": "res://Scripts/Managers/MissionManager.gd"
}, {
"base": "Reference",
"class": "CarManager",
"language": "GDScript",
"path": "res://Scripts/Managers/CarManager.gd"
}, {
"base": "Reference",
"class": "AudioManager",
"language": "GDScript",
"path": "res://Scripts/Managers/AudioManager.gd"
}, {
"base": "Reference",
"class": "UIManager",
"language": "GDScript",
"path": "res://Scripts/Managers/UIManager.gd"
} ]

_global_script_class_icons={
"AudioManager": "",
"CarManager": "",
"GameManager": "",
"MissionManager": "",
"SaveManager": "",
"UIManager": ""
}

[application]

config/name="Godot Racing 3D"
config/description="3D Open World Racing Game - AAA Quality Indie"
run/main_scene="res://Scenes/Menu/MainMenu.tscn"
config/icon="res://icon.png"
config/windows_native_title=true

[autoload]

GameManagerInstance="*res://Scripts/Managers/GameManager.gd"
SaveManagerInstance="*res://Scripts/Managers/SaveManager.gd"
MissionManagerInstance="*res://Scripts/Managers/MissionManager.gd"
CarManagerInstance="*res://Scripts/Managers/CarManager.gd"
AudioManagerInstance="*res://Scripts/Managers/AudioManager.gd"
UIManagerInstance="*res://Scripts/Managers/UIManager.gd"

[debug]

print_error_messages=true
print_verbose_messages=true

[display]

window/size/width=1920
window/size/height=1080
window/vsync/enabled=true
window/per_pixel_transparency/enabled=false

[input]

ui_accept=[ Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"command":false,"pressed":false,"scancode":16777221,"physical_scancode":0,"unicode":0,"echo":false,"script":null) ]
ui_select=[ Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":0,"button_index":3,"pressure":0.0,"pressed":false,"script":null) ]
ui_cancel=[ Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"command":false,"pressed":false,"scancode":16777217,"physical_scancode":0,"unicode":0,"echo":false,"script":null) ]
car_forward=[ Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"command":false,"pressed":false,"scancode":87,"physical_scancode":0,"unicode":0,"echo":false,"script":null) ]
car_backward=[ Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"command":false,"pressed":false,"scancode":83,"physical_scancode":0,"unicode":0,"echo":false,"script":null) ]
car_left=[ Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"command":false,"pressed":false,"scancode":65,"physical_scancode":0,"unicode":0,"echo":false,"script":null) ]
car_right=[ Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"scancode":68,"physical_scancode":0,"unicode":0,"echo":false,"script":null) ]

[physics]

3d/physics_engine="Bullet"
3d/default_gravity=9.8
3d/default_gravity_vector=Vector3(0,-1,0)

[rendering]

environment/default_clear_color=Color(0.2,0.2,0.2,1)
environment/default_ambient_light_energy=1.0
